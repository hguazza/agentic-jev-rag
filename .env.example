# OpenRouter key: one key covers every Model role, Jev included (ADR 0005)
OPEN_ROUTER_API_TOKEN=
# Defaults for running the APIs on the host; docker-compose.yml overrides them inside containers.
QDRANT_URL=http://localhost:6333
RAG_URL=http://localhost:8000
# Which System 1 decider the services use by default: llm or jev
SYSTEM_1=llm

# LiveKit Cloud project (voice interviews only, ADR 0012): Settings → API keys at cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where the voice worker reaches the Recruiter API (default http://localhost:8001)
RECRUITER_URL=http://localhost:8001
